{
  "name": "ygoangelus",
  "version": "0.0.1",
  "description": "YGOPro card resources and isolated OCGCore duels over WebSocket",
  "author": "Nanahira",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --fix src test",
    "test": "npm run build && vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "npm run build && vitest run --config vitest.config.mts test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/config": "^12",
    "@nestjs/swagger": "^12",
    "class-validator": "^0.15",
    "class-transformer": "^0.5",
    "nesties": "^2",
    "yaml": "^2",
    "ws": "^8",
    "yuzuthread": "1.0.10",
    "koishipro-core.js": "2.0.0-0",
    "ygopro-msg-encode": "1.4.0",
    "ygopro-cdb-encode": "^1.1.1",
    "ygopro-deck-encode": "^1.0.16",
    "ygopro-lflist-encode": "^1.0.3",
    "sql.js": "^1.13.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5",
    "@types/ws": "^8",
    "@types/sql.js": "^1",
    "tsx": "^4"
  }
}
